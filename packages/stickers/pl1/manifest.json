  "motions": {
    "bounce": "jumps twice, squashing a little as it lands",
    "wobble": "rocks side to side on its base, laughing",
    "beat": "swells and settles twice, like a heartbeat",
    "shake": "shakes side to side, hard at first, then less",
    "shiver": "trembles in small quick steps",
    "wave": "swings on its base like a waving hand",
    "nod": "dips twice, a nod or a small bow",
    "sway": "leans slowly to one side and back",
    "float": "rises a little, as if lifting something up, and settles",
    "pop": "grows quickly and settles back",
    "tilt": "tilts its head and comes back",
    "swing": "winds back and swings forward, like a pickaxe",
    "sink": "sinks a little and bobs back up",
    "glitch": "jumps between offset positions, like a lagging frame"
  },
