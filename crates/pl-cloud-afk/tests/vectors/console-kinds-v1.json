{
  "description": "Cloud AFK console kinds (services/cloud-afk/README.md, 'Console kinds'). stdout: one raw output line of a client started with MCC_CONSOLE_KINDS=1 and the bridge nonce 'nonce' (stream stdout or stderr) and what afk-host makes of it: a console line event, a boss bar event (normalized), another bridge event, a plain text line (c: cli on stdout, err on stderr; the nonce masked as ******), or drop (shown to nobody). kinds: a console line event (src, text, and ct, who, guess as the client gave them) of an account on 'server' and its kind {c, who?, log}; 'patterns' are the server's console patterns when the case gives its own, else the defaults of feat/settings-v1.json (listed in 'defaultPatterns'; servers without patterns have none). Generated by generate-console-kinds-v1.mjs; do not edit by hand.",
  "nonce": "Nq3vX8LkPz2RwT5yHc7dJm9bFs4gA1eU",
  "kinds": ["chat", "pm", "sys", "bar", "title", "cli", "err"],
  "defaultPatterns": {
    "projects.gg": {
      "pm": "^✉ »» (?<name>[A-Za-z0-9_]{3,16}): (?<text>.*)$",
      "pmOut": "^✉ «« (?<name>[A-Za-z0-9_]{3,16}): (?<text>.*)$",
      "chat": "^(?:\\[[^\\]]{1,24}\\] )?(?<name>[A-Za-z0-9_]{3,16}) » (?<text>.*)$"
    }
  },
  "stdout": [
    {
      "name": "a line event",
      "stream": "stdout",
      "raw": "Nq3vX8LkPz2RwT5yHc7dJm9bFs4gA1eU@@MCC@@{\"e\":\"line\",\"src\":\"system\",\"text\":\"Takas> Takas tamamlandı.\"}",
      "expected": {
        "kind": "line",
        "event": {
          "src": "system",
          "text": "Takas> Takas tamamlandı."
        }
      }
    },
    {
      "name": "a line event with every field",
      "stream": "stdout",
      "raw": "Nq3vX8LkPz2RwT5yHc7dJm9bFs4gA1eU@@MCC@@{\"e\":\"line\",\"src\":\"player\",\"text\":\"<Kaan> selam\",\"ct\":\"minecraft:chat\",\"who\":\"Kaan\",\"guess\":\"chat\"}",
      "expected": {
        "kind": "line",
        "event": {
          "src": "player",
          "text": "<Kaan> selam",
          "ct": "minecraft:chat",
          "who": "Kaan",
          "guess": "chat"
        }
      }
    },
    {
      "name": "unknown fields are ignored",
      "stream": "stdout",
      "raw": "Nq3vX8LkPz2RwT5yHc7dJm9bFs4gA1eU@@MCC@@{\"e\":\"line\",\"src\":\"client\",\"text\":\"Bağlanılıyor…\",\"seq\":4,\"extra\":{\"a\":1}}",
      "expected": {
        "kind": "line",
        "event": {
          "src": "client",
          "text": "Bağlanılıyor…"
        }
      }
    },
    {
      "name": "a field of the wrong type is left out",
      "stream": "stdout",
      "raw": "Nq3vX8LkPz2RwT5yHc7dJm9bFs4gA1eU@@MCC@@{\"e\":\"line\",\"src\":\"system\",\"text\":\"x\",\"who\":7}",
      "expected": {
        "kind": "line",
        "event": {
          "src": "system",
          "text": "x"
        }
      }
    },
