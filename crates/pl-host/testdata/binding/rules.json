    {
      "name": "No",
      "friend": "123456789012345678",
      "expect": "invalid"
    },
    {
      "name": "has space",
      "friend": "123456789012345678",
      "expect": "invalid"
    },
    {
      "name": "Ayşe",
      "friend": "123456789012345678",
      "expect": "invalid"
