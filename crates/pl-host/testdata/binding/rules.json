  "cases": [
    {
      "name": "Notch",
      "friend": "123456789012345678",
      "expect": "ok"
    },
    {
      "name": "notch",
      "friend": "123456789012345678",
      "expect": "ok"
    },
    {
      "name": "Notch",
      "friend": "345678901234567890",
