        "crews": [{ "id": "t1" }]
      },
      "heard": true
    },
    {
      "name": "the service's crew call switch wins over this computer's (off)",
      "event": { "kind": "call", "crews": ["t1"] },
      "situation": {
        "crewCalls": true,
        "service": { "calls": false, "muted": false, "muteUntil": null },
        "crews": [{ "id": "t1" }]
      },
      "heard": false
    },
    {
      "name": "all crews muted for a while silences calls",
      "event": { "kind": "call", "crews": ["t1"] },
      "situation": {
        "service": { "calls": true, "muted": true, "muteUntil": 1800000600 },
        "crews": [{ "id": "t1" }]
      },
      "heard": false
    },
    {
      "name": "all crews muted until a time that passed lets calls through",
      "event": { "kind": "call", "crews": ["t1"] },
      "situation": {
        "service": { "calls": true, "muted": true, "muteUntil": 1799999000 },
        "crews": [{ "id": "t1" }]
      },
      "heard": true
    },
    {
      "name": "a call to one muted crew stays quiet",
      "event": { "kind": "call", "crews": ["t1"] },
      "situation": {
        "crews": [{ "id": "t1", "muted": true, "muteUntil": null }, { "id": "t2" }]
      },
      "heard": false
    },
    {
      "name": "a call to a muted and an unmuted crew is heard",
      "event": { "kind": "call", "crews": ["t1", "t2"] },
      "situation": {
        "crews": [{ "id": "t1", "muted": true, "muteUntil": null }, { "id": "t2" }]
      },
      "heard": true
    },
    {
      "name": "a call naming no crew is the first crew's (muted)",
      "event": { "kind": "call", "crews": [] },
      "situation": {
        "crews": [{ "id": "t1", "muted": true, "muteUntil": null }, { "id": "t2" }]
      },
      "heard": false
    },
    {
      "name": "a call naming no crew is the first crew's (not muted)",
      "event": { "kind": "call", "crews": [] },
      "situation": {
        "crews": [{ "id": "t1" }, { "id": "t2", "muted": true, "muteUntil": null }]
      },
      "heard": true
    },
    {
      "name": "a call naming no crew while the list is empty is heard",
      "event": { "kind": "call", "crews": [] },
      "heard": true
    },
    {
      "name": "a call naming only crews the list does not have is heard",
      "event": { "kind": "call", "crews": ["t9"] },
      "situation": { "crews": [{ "id": "t1", "muted": true, "muteUntil": null }] },
      "heard": true
    },
    {
      "name": "do not disturb silences calls",
      "event": { "kind": "call", "crews": ["t1"] },
      "situation": { "status": "dnd", "crews": [{ "id": "t1" }] },
      "heard": false
