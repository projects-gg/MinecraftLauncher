{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Projects Launcher",
  "mainBinaryName": "projects-launcher",
  "identifier": "gg.projects.launcher",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Projects Launcher",
        "width": 1200,
        "height": 712,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "decorations": false,
        "visible": false,
        "resizable": true,
        "dragDropEnabled": true,
        "backgroundColor": "#0b0907"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' asset: http://asset.localhost data: blob: https://cdn.projects.gg https://raw.githubusercontent.com https://cdn.modrinth.com https://cdn.discordapp.com https://textures.minecraft.net",
        "media-src": "'self' asset: http://asset.localhost blob: https://cdn.projects.gg",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "worker-src": "'self' blob:"
      },
      "dangerousDisableAssetCspModification": ["style-src"],
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "appimage", "deb", "rpm"],
    "createUpdaterArtifacts": true,
    "publisher": "Projects.gg",
    "homepage": "https://projects.gg",
    "copyright": "© Projects.gg",
    "license": "GPL-3.0-only",
    "category": "Game",
    "shortDescription": "Projects.gg Minecraft launcher",
    "longDescription": "Projects.gg için Minecraft launcher: tüm sürümler, mod yükleyiciler, resmi mod paketi, haberler ve AFK hesapları.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Turkish"],
        "displayLanguageSelector": false,
        "customLanguageFiles": {
          "Turkish": "nsis/Turkish.nsh"
        },
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "headerImage": "nsis/header.bmp",
        "sidebarImage": "nsis/sidebar.bmp"
      }
    },
    "macOS": {
      "bundleVersion": "2.0.999",
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["projects"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI2MDY3NjQzNEUxQTUzNTkKUldSWlV4cE9RM1lHSnJBUHhhaDJhS2o2NmdlS2lydU9YcHppTmNZZnA4aS9GcjFDemIrWEphMk4K",
      "endpoints": [],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
