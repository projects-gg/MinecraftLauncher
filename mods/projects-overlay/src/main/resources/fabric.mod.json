{
  "schemaVersion": 1,
  "id": "projects_overlay",
  "version": "${version}",
  "name": "Projects Overlay",
  "description": "Messages, crew calls and friends from Projects Launcher, inside the game.",
  "authors": ["Projects"],
  "contact": {
    "homepage": "https://projects.gg",
    "sources": "https://github.com/projects-gg/MinecraftLauncher"
  },
  "license": "GPL-3.0-only",
  "environment": "client",
  "custom": {
    "projects:bridge": {
      "proto": 1
    }
  },
  "entrypoints": {
    "client": ["gg.projects.overlay.OverlayClient"]
  },
  "mixins": [
    {
      "config": "projects-overlay.host.mixins.json",
      "environment": "client"
    },
    {
      "config": "projects-overlay.connect.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "${minecraft_range}",
    "java": ">=25",
    "fabric-key-mapping-api-v1": "*",
    "fabric-lifecycle-events-v1": "*",
    "fabric-networking-api-v1": "*",
    "fabric-rendering-v1": "*",
    "fabric-resource-loader-v1": "*",
    "fabric-screen-api-v1": "*"
  }
}
