# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
target/
*.tsbuildinfo

# Tauri generated
apps/*/src-tauri/gen/schemas/

# The in-game overlay's jars, built before a release (scripts/release/overlay-jars.mjs)
apps/launcher/src-tauri/overlay/

# Secrets — never commit keys or credentials
.env
.env.*
!.env.example
*.pem
*.pfx
*.p12
*.snk
*.minisign.key
*.updater.key
secrets/

# Logs and OS files
*.log
.DS_Store
Thumbs.db

# IDE
.vs/
.idea/
*.user

# Local tooling
graphify-out/
# AI assistant settings and instructions stay local
.claude/
.codex/
/AGENTS.md
/CLAUDE.local.md

# Cloudflare Workers local state and local secrets (the Workers now live in the Studio
# repository; kept so a stale local copy never gets committed here)
.wrangler/
.dev.vars

# Internal development notes stay on the maintainers' machines. The content format spec stays
# tracked: pl-content tests (and Studio's, in its own repository) check its JSON examples.
/CLAUDE.md
/todo.md
/docs/*
!/docs/content-format.md
/scripts/secrets-sync.mjs

# Python bytecode
__pycache__/
*.pyc
