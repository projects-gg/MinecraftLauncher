{
  "name": "projects-launcher-workspace",
  "private": true,
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @pl/launcher tauri dev",
    "dev:web": "pnpm --filter @pl/launcher dev",
